#!/bin/sh
# Model-action interpreter for agent(1). Ply invokes this as SHELL -c SCRIPT.
# Cage, not this wrapper, owns the confinement claim.

set -eu

die() {
	printf 'agent-action-shell: %s\n' "$*" >&2
	exit 125
}

[ "$#" -eq 2 ] && [ "$1" = "-c" ] || die 'expected -c SCRIPT'
[ -n "${AGENT_WORK:-}" ] || die 'AGENT_WORK is not set'
[ -n "${AGENT_STATE:-}" ] || die 'AGENT_STATE is not set'

cage=${AGENT_CAGE:-cage}
command -v "$cage" >/dev/null 2>&1 || die "cage not found: $cage"

# Cage confines path writes. A pre-existing hard link inside a writable root
# can still alias an inode named outside it, so raw Cage callers must refuse
# that condition. This conservative check rejects every multiply-linked file,
# including links whose other names may also be inside the granted roots.
if find "$AGENT_WORK" "$AGENT_STATE" -type f -links +1 -print -quit 2>/dev/null | grep -q .; then
	die 'work or state contains a multiply-linked regular file'
fi

if [ "${AGENT_NET:-0}" = 1 ]; then
	exec "$cage" -net -w "$AGENT_WORK" -w "$AGENT_STATE" -- /bin/sh -c "$2"
fi

exec "$cage" -w "$AGENT_WORK" -w "$AGENT_STATE" -- /bin/sh -c "$2"
